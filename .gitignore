# =====================================================================
# OWCS Comp Tracker — .gitignore
# Keep: source, docs, tests, layouts, per-source template dirs, schema,
#       public pages, the SQLite DB, the public export, and the ESSENTIAL
#       milestone evidence the public data + fixture + reports reference.
# Drop: multi-GB VODs/clips/frames, scratch, caches, transient DB sidecars,
#       template cluster candidates, and generated bulk reports.
# =====================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtualenvs / tooling ---
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
node_modules/

# --- OS / editor junk ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# --- Secrets / local config (never commit) ---
.env
*.env
!.env.example
*.key
*.pem
credentials*.json
secrets*.json

# --- Large media & local scratch (multi-GB; never commit) ---
work/
*.mp4
*.mkv
*.webm
*.m4a
*.part
*.ytdl
*.f4v
*.mov
*.avi
*.ts
*.m3u8

# --- Beta closed-loop worker media (Phase E): downloaded VODs, extracted
#     segment clips, and generated thumbnails. Never committed — only the
#     automation DB's metadata (hash/duration/resolution/path) references
#     these files; the files themselves stay local to the worker machine. ---
data/worker/

# --- SQLite transient sidecars (the .sqlite itself IS committed) ---
data/owcs.sqlite-wal
data/owcs.sqlite-shm

# --- Automation job queue (RUNTIME state, regenerable via `cli.py init-db`;
#     unlike owcs.sqlite this is a worker queue, not committed content) ---
data/automation.sqlite
data/automation.sqlite-wal
data/automation.sqlite-shm
data/raw/

# --- Auto match finder ledger (operator-local discovery archive; the
#     publishable snapshot is assets/data/matchfinder.v1.json, which IS
#     committed) ---
data/match_finder.json

# --- Team logo pipeline staging (Phase D2): transient downloaded candidate
#     images before human approval + variant generation. Never committed —
#     only a PUBLISHED, human-approved asset reaches assets/img/teams/. ---
data/asset_staging/
# Unattended pass logs + their JSON summaries: runtime state, written
# by `cli.py auto-run` on whatever machine runs the schedule.
data/auto-run-logs/

# --- Template cluster scratch (4-5 MB, regenerable via harvest --cluster) ---
_candidates/
candidates/

# --- Reports: keep ONLY the essential milestone evidence ---------------
#   * reports/ingest/qad-twis-nepal/     -> production public_data.v1.js evidence
#   * reports/capture_trial/             -> fixture evidence (test-validated)
#   * reports/calibration/owcs-jksix-qwc -> calibration sheet
# Everything else under reports/ (reports/auto, dryrun output, ...) is
# generated bulk and stays out.
reports/*
!reports/ingest/
reports/ingest/*
!reports/ingest/qad-twis-nepal/
!reports/capture_trial/
!reports/calibration/
reports/calibration/*
!reports/calibration/owcs-jksix-qwc/

# Operator runtime snapshot for intake.html. Regenerated on every
# `intake-export --save` / `convert-link` run and specific to whoever is
# operating (their job queue, pasted URLs, local media paths), so it is
# deliberately NOT committed. intake.html degrades to its documented
# "generate one with ..." message when the file is absent, and the local
# control room serves the LIVE report from /api/intake instead.
assets/data/intake.v1.json
